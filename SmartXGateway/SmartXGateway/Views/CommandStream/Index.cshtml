@model SmartXGateway.Models.CommandStreamViewModel
@{
    ViewData["Title"] = "Real-Time Command Stream";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2>⚡ Real-Time Command Stream</h2>
    <div>
        <button id="btnDrain" class="btn smartx-btn-secondary">🚚 Process Queue</button>
        <button id="btnUndo" class="btn smartx-btn-secondary">↺ Undo Last Command</button>
        <a class="btn smartx-btn-secondary" asp-controller="Home" asp-action="Index">← Back</a>
    </div>
</div>

@* RUBRIC IMPROVEMENT: hidden antiforgery token so the fetch POSTs can send it. *@
@Html.AntiForgeryToken()

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card smartx-kpi smartx-kpi-blue">
            <div class="card-body"><h6>Registered Devices</h6><h3 id="kpiDevices">@Model.Devices.Count</h3></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card smartx-kpi smartx-kpi-green">
            <div class="card-body"><h6>FIFO Queue</h6><h3 id="kpiQueued">@Model.QueuedCount</h3></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card smartx-kpi smartx-kpi-yellow">
            <div class="card-body"><h6>Priority Queue</h6><h3 id="kpiPriority">@Model.PriorityCount</h3></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card smartx-kpi smartx-kpi-pink">
            <div class="card-body"><h6>Unique Alerts (HashSet)</h6><h3 id="kpiAlerts">@Model.AnomalyCount</h3></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card smartx-card-pastel-blue mb-3">
            <div class="card-header">🔎 Filter Devices <small class="text-muted">(feeds the predictive engine)</small></div>
            <div class="card-body">
                <input id="searchTerm" class="form-control mb-2" placeholder="Search by MAC, location or category..." />
                <select id="searchCat" class="form-select mb-2">
                    <option value="">All categories</option>
                    <option value="0">Environmental</option>
                    <option value="1">PowerConsumption</option>
                    <option value="2">Actuator</option>
                </select>
                <button id="btnFilter" class="btn smartx-btn-primary w-100">Search</button>
            </div>
        </div>

        <div class="card smartx-card-pastel-yellow mb-3">
            <div class="card-header">🤖 Suggested Actions <small class="text-muted">(learned + telemetry + live + trending)</small></div>
            <ul id="suggestions" class="list-group list-group-flush" style="max-height:300px; overflow-y:auto;">
                @if (Model.Suggestions.Count == 0)
                {
                    <li class="list-group-item text-muted">Start searching or issuing commands — patterns will appear here.</li>
                }
                else
                {
                    foreach (var s in Model.Suggestions)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong>@s.Title</strong>
                                <span class="badge smartx-badge">@s.Confidence%</span>
                            </div>
                            <small class="text-muted d-block">@s.Reason</small>
                            <small class="text-muted">Source: <em>@s.Source</em></small><br />
                            @if (s.IsExecutable)
                            {
                                <button class="btn btn-sm smartx-btn-secondary mt-1 quick-cmd"
                                        data-mac="@s.DeviceMac" data-cmd="@s.SuggestedCommand">
                                    Execute: @s.SuggestedCommand
                                </button>
                            }
                        </li>
                    }
                }
            </ul>
        </div>

        <div class="card smartx-card-pastel-pink mb-3">
            <div class="card-header">🎛 Issue Manual Override</div>
            <div class="card-body">
                <label class="form-label">Device</label>
                <select id="cmdMac" class="form-select mb-2">
                    @foreach (var d in Model.Devices)
                    {
                        <option value="@d.MacAddress">@d.MacAddress — @d.Location</option>
                    }
                </select>
                <label class="form-label">Command</label>
                <select id="cmdType" class="form-select mb-2">
                    <option>OPEN_VALVE</option>
                    <option>CLOSE_VALVE</option>
                    <option>TOGGLE_RELAY</option>
                    <option>SHUTDOWN_RELAY</option>
                    <option>RESTORE_RELAY</option>
                    <option>REBOOT_NODE</option>
                </select>
                <label class="form-label">Payload (optional)</label>
                <input id="cmdPayload" class="form-control mb-2" placeholder="e.g. duration=30s" />
                <button id="btnIssue" class="btn smartx-btn-primary w-100">Send Command</button>
                <div id="issueResult" class="small text-muted mt-2"></div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card smartx-card-pastel-blue mb-3">
            <div class="card-header">
                ⏱ Timeline (SortedDictionary range query)
                <div class="float-end">
                    <input type="datetime-local" id="tlFrom" class="form-control form-control-sm d-inline-block" style="width:auto; display:inline-block;" />
                    <input type="datetime-local" id="tlTo" class="form-control form-control-sm d-inline-block" style="width:auto; display:inline-block;" />
                    <button id="btnRange" class="btn btn-sm smartx-btn-secondary">Range</button>
                    <button id="btnResetRange" class="btn btn-sm smartx-btn-secondary">Reset</button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="timelineChart" height="90"></canvas>
            </div>
        </div>

        <div class="card smartx-card-pastel-green mb-3">
            <div class="card-header">📡 Live Devices (Dictionary&lt;MAC, DeviceState&gt;)</div>
            <div class="table-responsive" style="max-height:240px; overflow-y:auto;">
                <table class="table table-sm mb-0">
                    <thead><tr><th>MAC</th><th>Location</th><th>Category</th><th>Last</th><th>Flags</th><th>State</th></tr></thead>
                    <tbody id="deviceBody">
                        @foreach (var d in Model.Devices)
                        {
                            <tr class="@(d.IsAlerted ? "table-warning" : "")">
                                <td><code>@d.MacAddress</code></td>
                                <td>@d.Location</td>
                                <td>@d.Category</td>
                                <td>@d.LastValue.ToString("F2")</td>
                                <td>
                                    @foreach (var f in d.DeviceFlags)
                                    {
                                        <span class="badge smartx-badge">@f.Key=@f.Value</span>
                                    }
                                </td>
                                <td>
                                    @if (!d.IsConnected)
                                    {
                                        <span class="badge smartx-badge-fail">Down</span>
                                    }
                                    else if (d.IsAlerted)
                                    {
                                        <span class="badge smartx-badge">@d.CurrentAlert</span>
                                    }
                                    else
                                    {
                                        <span class="badge smartx-badge-ok">OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card smartx-card-pastel-blue mb-3">
            <div class="card-header">📜 Command History (Stack&lt;CommandRecord&gt;)</div>
            <ul id="commandHistory" class="list-group list-group-flush" style="max-height:200px; overflow-y:auto;">
                @foreach (var c in Model.CommandHistory.Take(20))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><code>@c.DeviceMac</code> — @c.CommandType</span>
                        <small class="text-muted">@c.IssuedAt.ToLocalTime().ToString("HH:mm:ss")</small>
                    </li>
                }
            </ul>
        </div>

        <div class="card smartx-card-pastel-yellow">
            <div class="card-header">🔔 Live Stream</div>
            <ul id="streamFeed" class="list-group list-group-flush smartx-feed"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ✅ FIX: Removed the invalid SHA hash so Chart.js actually loads -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/command-stream.js" asp-append-version="true"></script>
    <script>
        window.__initialTimeline = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Timeline));
        sessionStorage.setItem('smartx.lastmodule', 'CommandStream');
    </script>
}

